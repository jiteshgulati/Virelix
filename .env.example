# Copy to .env (never commit .env). Every value is optional for local development.

# The ONE designated Owner of this installation (a shared installation has exactly one).
# The verified account with this address becomes Owner; teammates register normally and are
# invited as Admins. Changing it later never transfers ownership automatically: see
# scripts/owner_recovery.py.
OWNER_EMAIL=owner@example.com

# Reserved for future signed tokens. Week 1 doesn't sign anything: every token is random
# and stored hashed. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
VIRELIX_SECRET_KEY=

# development | production. Development enables the local mailbox (links are NOT delivered).
VIRELIX_ENV=development
VIRELIX_HOST=127.0.0.1
VIRELIX_PORT=8000

# Set to 1 when serving over HTTPS so cookies get the Secure flag.
VIRELIX_SECURE_COOKIES=0

# Optional overrides
# VIRELIX_CORPUS_DIR=corpus
# VIRELIX_DATA_DIR=data
# VIRELIX_PUBLIC_URL=http://localhost:8000
# VIRELIX_DEV_MAILBOX=1
# VIRELIX_REGISTER_RATE_LIMIT=20
# Key for the developer mailbox page (development mode, this machine only). If unset, a new
# random key is generated and printed to the console at every start.
# VIRELIX_DEV_MAILBOX_KEY=
